      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "targets": [
        {
          "expr": "sum by (status) (increase(http_server_requests_seconds_count[1m]))",
          "legendFormat": "HTTP {{status}}"
        }
      ],
      "title": "HTTP Responses by Status Code",
      "type": "timeseries"
